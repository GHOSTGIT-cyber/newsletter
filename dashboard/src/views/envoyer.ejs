<%- include('_entete', { titre: 'Envoyer' }) %>
<main class="page etroite">
  <p><a href="/newsletters/<%= n.id %>">← Retour à l'éditeur</a></p>
  <h1>Envoyer « <%= n.nom %> »</h1>
  <% if (erreur) { %><p class="alerte"><%= erreur %></p><% } %>

  <section class="carte">
    <h2>Ce qui va partir</h2>
    <dl class="recap">
      <dt>Objet</dt><dd class="fort"><%= objet %></dd>
      <dt>Destinataires</dt><dd class="fort"><%= comptes.actif %> contact<%= comptes.actif > 1 ? 's' : '' %> actif<%= comptes.actif > 1 ? 's' : '' %></dd>
      <dt>Exclus</dt><dd class="discret"><%= comptes.desabonne %> désabonné(s), <%= comptes.rebond %> rebond(s), <%= comptes.plainte %> plainte(s)</dd>
      <dt>Aujourd'hui</dt><dd>
        <% if (comptes.actif <= budget) { %>
          les <%= comptes.actif %> partent aujourd'hui
        <% } else { %>
          <%= budget %> aujourd'hui, les <%= comptes.actif - budget %> restants demain
          <span class="discret">(plafond de <%= plafond %>/jour)</span>
        <% } %>
      </dd>
    </dl>
  </section>

  <% const bloquants = [];
     if (!configure) bloquants.push("La clé Resend n'est pas configurée sur le serveur.");
     if (comptes.actif === 0) bloquants.push("Aucun contact actif : importez une liste dans Contacts.");
     if (!adressePostale) bloquants.push("L'adresse postale n'est pas renseignée dans Réglages — elle est obligatoire dans le pied de page.");
  %>

  <% if (bloquants.length) { %>
    <section class="carte">
      <h2>À régler avant d'envoyer</h2>
      <ul class="liste-fine">
        <% for (const b of bloquants) { %><li class="alerte-ligne"><%= b %></li><% } %>
      </ul>
    </section>
  <% } else { %>
    <section class="carte">
      <h2>Vérifications</h2>
      <ul class="liste-fine">
        <li>Avez-vous relu le texte et l'objet ?</li>
        <li>Avez-vous reçu un test sur votre propre boîte<%= emailTest ? ' (' + emailTest + ')' : '' %> ?</li>
        <li>Une fois partie, la newsletter passe en lecture seule et ne peut plus être corrigée.</li>
      </ul>
      <form method="post" action="/newsletters/<%= n.id %>/envoyer" id="formulaire-envoi">
        <input type="hidden" name="confirmation" value="<%= comptes.actif %>">
        <input type="hidden" name="quand_utc" id="quand_utc">

        <div class="choix-envoi">
          <label class="option"><input type="radio" name="mode" value="maintenant" checked>
            <span><span class="fort">Envoyer maintenant</span><span class="discret">Le départ commence dans la minute.</span></span></label>
          <label class="option"><input type="radio" name="mode" value="programme">
            <span><span class="fort">Programmer l'envoi</span><span class="discret">La newsletter part toute seule à l'heure choisie, même si personne n'est devant l'écran.</span></span></label>
        </div>

        <div id="bloc-date" hidden>
          <label>Date et heure (heure française)
            <input type="datetime-local" name="quand_local" id="quand_local" value="<%= suggestion %>" min="<%= minimum %>">
          </label>
          <p class="discret" id="rappel-date">Jusqu'à cette heure, la newsletter reste programmée et vous pouvez annuler.</p>
        </div>

        <button type="submit" class="principal grand" id="bouton-envoi">Envoyer à <%= comptes.actif %> destinataire<%= comptes.actif > 1 ? 's' : '' %></button>
      </form>

      <script>
        (function () {
          const f = document.getElementById("formulaire-envoi");
          const bloc = document.getElementById("bloc-date");
          const local = document.getElementById("quand_local");
          const utc = document.getElementById("quand_utc");
          const bouton = document.getElementById("bouton-envoi");
          const nb = <%= comptes.actif %>;
          const mode = () => f.querySelector('input[name="mode"]:checked').value;

          function majuscule() {
            const programme = mode() === "programme";
            bloc.hidden = !programme;
            bouton.textContent = programme
              ? "Programmer l'envoi à " + nb + " destinataire" + (nb > 1 ? "s" : "")
              : "Envoyer à " + nb + " destinataire" + (nb > 1 ? "s" : "");
          }
          f.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener("change", majuscule));
          majuscule();

          f.addEventListener("submit", (e) => {
            if (mode() === "programme") {
              // Le navigateur connaît le fuseau d'Anna : on envoie l'instant exact.
              const d = new Date(local.value);
              if (!local.value || isNaN(d)) { e.preventDefault(); local.focus(); return; }
              if (d.getTime() < Date.now() + 60000) { e.preventDefault(); alert("Choisissez une heure à venir."); return; }
              utc.value = d.toISOString();
              const quand = d.toLocaleString("fr-FR", { weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });
              if (!confirm("Programmer l'envoi à " + nb + " destinataires pour " + quand + " ?")) e.preventDefault();
              return;
            }
            if (!confirm("Envoyer à " + nb + " destinataire" + (nb > 1 ? "s" : "") + " ? Cette action est irréversible.")) e.preventDefault();
          });
        })();
      </script>
    </section>
  <% } %>
</main>
<%- include('_pied') %>
