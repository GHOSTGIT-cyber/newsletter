<%- include('_entete', { titre: 'Envoyer' }) %>
<main class="page etroite">
  <p><a href="/newsletters/<%= n.id %>">← Retour à l'éditeur</a></p>
  <h1>Envoyer « <%= n.nom %> »</h1>
  <% if (erreur) { %><p class="alerte"><%= erreur %></p><% } %>

  <section class="carte">
    <h2>Ce qui va partir</h2>
    <dl class="recap">
      <dt>Objet</dt><dd class="fort"><%= objet %></dd>
      <dt>Destinataires</dt><dd class="fort"><%= comptes.actif %> contact<%= comptes.actif > 1 ? 's' : '' %> actif<%= comptes.actif > 1 ? 's' : '' %></dd>
      <dt>Exclus</dt><dd class="discret"><%= comptes.desabonne %> désabonné(s), <%= comptes.rebond %> rebond(s), <%= comptes.plainte %> plainte(s)</dd>
      <dt>Aujourd'hui</dt><dd>
        <% if (comptes.actif <= budget) { %>
          les <%= comptes.actif %> partent aujourd'hui
        <% } else { %>
          <%= budget %> aujourd'hui, les <%= comptes.actif - budget %> restants demain
          <span class="discret">(plafond de <%= plafond %>/jour)</span>
        <% } %>
      </dd>
    </dl>
  </section>

  <% const bloquants = [];
     if (!configure) bloquants.push("La clé Resend n'est pas configurée sur le serveur.");
     if (comptes.actif === 0) bloquants.push("Aucun contact actif : importez une liste dans Contacts.");
     if (!adressePostale) bloquants.push("L'adresse postale n'est pas renseignée dans Réglages — elle est obligatoire dans le pied de page.");
  %>

  <% if (bloquants.length) { %>
    <section class="carte">
      <h2>À régler avant d'envoyer</h2>
      <ul class="liste-fine">
        <% for (const b of bloquants) { %><li class="alerte-ligne"><%= b %></li><% } %>
      </ul>
    </section>
  <% } else { %>
    <section class="carte">
      <h2>Vérifications</h2>
      <ul class="liste-fine">
        <li>Avez-vous relu le texte et l'objet ?</li>
        <li>Avez-vous reçu un test sur votre propre boîte<%= emailTest ? ' (' + emailTest + ')' : '' %> ?</li>
        <li>Une fois partie, la newsletter passe en lecture seule et ne peut plus être corrigée.</li>
      </ul>
      <form method="post" action="/newsletters/<%= n.id %>/envoyer" id="formulaire-envoi">
        <input type="hidden" name="confirmation" value="<%= comptes.actif %>">
        <input type="hidden" name="quand_utc" id="quand_utc">

        <div class="vagues">
          <label>Envoyer par vagues de
            <input type="number" name="vague" id="vague" value="<%= plafond %>" min="1" max="100000" step="50">
            emails par jour
          </label>
          <p class="discret" id="recap-vagues"></p>
        </div>

        <div class="choix-envoi">
          <label class="option"><input type="radio" name="mode" value="maintenant" checked>
            <span><span class="fort">Envoyer maintenant</span><span class="discret">Le départ commence dans la minute.</span></span></label>
          <label class="option"><input type="radio" name="mode" value="programme">
            <span><span class="fort">Programmer l'envoi</span><span class="discret">La newsletter part toute seule à l'heure choisie, même si personne n'est devant l'écran.</span></span></label>
        </div>

        <div id="bloc-date" hidden>
          <p class="libelle-date">Quand faut-il l'envoyer ?</p>
          <div class="raccourcis" id="raccourcis">
            <button type="button" data-demain="08:30">Demain 8h30</button>
            <button type="button" data-demain="10:00">Demain 10h</button>
            <button type="button" data-demain="18:00">Demain 18h</button>
            <button type="button" data-heures="2">Dans 2 heures</button>
          </div>
          <div class="date-heure">
            <label>Jour
              <input type="date" name="jour" id="jour" value="<%= suggestionJour %>" min="<%= minimumJour %>">
            </label>
            <label>Heure
              <input type="time" name="heure" id="heure" value="<%= suggestionHeure %>" step="300">
            </label>
          </div>
          <p class="recap-date" id="recap-date"></p>
          <p class="discret">Heure française. Vous pourrez annuler tant que rien n'est parti.</p>
        </div>

        <button type="submit" class="principal grand" id="bouton-envoi">Envoyer à <%= comptes.actif %> destinataire<%= comptes.actif > 1 ? 's' : '' %></button>
      </form>

      <script>
        (function () {
          const f = document.getElementById("formulaire-envoi");
          const bloc = document.getElementById("bloc-date");
          const jour = document.getElementById("jour");
          const heure = document.getElementById("heure");
          const recap = document.getElementById("recap-date");
          const utc = document.getElementById("quand_utc");
          const bouton = document.getElementById("bouton-envoi");
          const vague = document.getElementById("vague");
          const recapVagues = document.getElementById("recap-vagues");
          const nb = <%= comptes.actif %>;
          const mode = () => f.querySelector('input[name="mode"]:checked').value;
          const pluriel = nb > 1 ? "s" : "";

          const deuxChiffres = (x) => String(x).padStart(2, "0");
          const enJour = (d) => d.getFullYear() + "-" + deuxChiffres(d.getMonth() + 1) + "-" + deuxChiffres(d.getDate());
          const enHeure = (d) => deuxChiffres(d.getHours()) + ":" + deuxChiffres(d.getMinutes());

          /** L'instant choisi, dans le fuseau du navigateur (celui d'Anna). */
          function choisi() {
            if (!jour.value || !heure.value) return null;
            const d = new Date(jour.value + "T" + heure.value);
            return isNaN(d) ? null : d;
          }

          const dire = (d) =>
            d.toLocaleString("fr-FR", { weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });

          /** « dans 25 min », « dans 3 h », « demain », « dans 4 jours ». */
          function delaiDit(d) {
            const minutes = Math.round((d.getTime() - Date.now()) / 60000);
            if (minutes < 60) return "dans " + minutes + " min";
            const minuit = new Date();
            minuit.setHours(0, 0, 0, 0);
            const jours = Math.round((new Date(d).setHours(0, 0, 0, 0) - minuit) / 86400000);
            if (jours === 0) return "dans " + Math.round(minutes / 60) + " h";
            if (jours === 1) return "demain";
            return "dans " + jours + " jours";
          }

          function direVagues() {
            const v = Math.round(Number(vague.value));
            if (!Number.isFinite(v) || v < 1) { recapVagues.textContent = ""; return; }
            if (v >= nb) {
              recapVagues.textContent = "Les " + nb + " partent le même jour, en " + Math.max(1, Math.round(nb * 0.6 / 60)) + " min environ.";
            } else {
              const jours = Math.ceil(nb / v);
              recapVagues.textContent = v + " le premier jour, puis le reste automatiquement les jours suivants : " + jours + " jours en tout.";
            }
          }
          vague.addEventListener("input", direVagues);
          direVagues();

          function rafraichir() {
            const programme = mode() === "programme";
            bloc.hidden = !programme;
            bouton.textContent = (programme ? "Programmer l'envoi à " : "Envoyer à ") + nb + " destinataire" + pluriel;
            if (!programme) return;
            const d = choisi();
            if (!d) {
              recap.textContent = "Choisissez un jour et une heure.";
              recap.className = "recap-date probleme";
            } else if (d.getTime() < Date.now() + 60000) {
              recap.textContent = "Cette heure est déjà passée.";
              recap.className = "recap-date probleme";
            } else {
              recap.textContent = "Départ " + dire(d) + " (" + delaiDit(d) + ").";
              recap.className = "recap-date";
            }
          }

          f.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener("change", rafraichir));
          jour.addEventListener("input", rafraichir);
          heure.addEventListener("input", rafraichir);

          document.getElementById("raccourcis").addEventListener("click", (e) => {
            const b = e.target.closest("button");
            if (!b) return;
            const d = new Date();
            if (b.dataset.demain) {
              d.setDate(d.getDate() + 1);
              const [h, m] = b.dataset.demain.split(":");
              d.setHours(Number(h), Number(m), 0, 0);
            } else {
              // On garde les minutes : « dans 2 heures » doit vraiment faire 2 heures.
              d.setHours(d.getHours() + Number(b.dataset.heures), d.getMinutes(), 0, 0);
            }
            jour.value = enJour(d);
            heure.value = enHeure(d);
            document.querySelectorAll("#raccourcis button").forEach((x) => x.classList.toggle("actif", x === b));
            rafraichir();
          });

          rafraichir();

          f.addEventListener("submit", (e) => {
            if (mode() === "programme") {
              const d = choisi();
              if (!d) { e.preventDefault(); jour.focus(); return; }
              if (d.getTime() < Date.now() + 60000) { e.preventDefault(); alert("Choisissez une heure à venir."); return; }
              // Le navigateur connaît le fuseau d'Anna : on envoie l'instant exact.
              utc.value = d.toISOString();
              if (!confirm("Programmer l'envoi à " + nb + " destinataire" + pluriel + " pour " + dire(d) + " ?")) e.preventDefault();
              return;
            }
            if (!confirm("Envoyer à " + nb + " destinataire" + pluriel + " ? Cette action est irréversible.")) e.preventDefault();
          });
        })();
      </script>
    </section>
  <% } %>
</main>
<%- include('_pied') %>
