# Copier en .env. Jamais commité.

# URL publique du dashboard, sans slash final (liens d'aperçu et de désabonnement).
PUBLIC_URL=http://localhost:3000
PORT=3000

# Fichier SQLite. En production : /data/newsletter.sqlite (volume Coolify).
DB_PATH=./data/newsletter.sqlite

# SANS_CONNEXION=1 supprime la page de connexion (développement local uniquement).
# SANS_CONNEXION=

# Comptes créés au premier démarrage, seulement si la table est vide.
# Format : email:motdepasse,email:motdepasse
COMPTES_INITIAUX=

# Envoi (phase 4)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="Lift Foils France <news@news.liftfoils.fr>"
DAILY_LIMIT=90
