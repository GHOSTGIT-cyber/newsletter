# Copier ce fichier en .env puis remplir les trois valeurs.
# .env ne doit jamais être commité : il contient une clé API.

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur. Le domaine doit être vérifié dans Resend (SPF + DKIM posés).
# Tant que le domaine du client n'est pas branché, utiliser le tien.
MAIL_FROM="Lift Foils France <news@news.liftfoils.fr>"

# URL publique des maquettes en ligne, sans slash final.
# Remplit le lien « voir dans le navigateur » de chaque email.
PREVIEW_BASE=https://newsletter.bakabi.fr

# Token API Coolify — https://coolify.bakabi.fr/security/api-tokens
# Utilise par `npm run publish:preview` pour mettre la preview en ligne.
COOLIFY_TOKEN=
